# Copy values into your deployment's secret configuration. Never commit secrets.
HOST=127.0.0.1
PORT=8787
EUNNEI_DATA_DIR=/data
EUNNEI_STATIC_DIR=/app/static
EUNNEI_MODEL=gpt-6-luna
# Required when HOST is not a loopback address. Set a long random private password.
APP_USERNAME=michael
APP_PASSWORD=
EUNNEI_REQUESTS_PER_HOUR=60
EUNNEI_REQUESTS_PER_MINUTE=6
# Optional exact origin for a separate private Sites preview. No wildcard.
EUNNEI_ALLOWED_ORIGIN=
