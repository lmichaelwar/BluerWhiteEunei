{
  "name": "eunnei-plan-bridge",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-24",
  "preview_urls": false,
  "assets": {
    "directory": "../build/site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "OFFICES", "class_name": "OfficeSession" }]
  },
  "exports": {
    "OfficeSession": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "EUNNEI_MODEL": "gpt-6-luna",
    "EUNNEI_REQUESTS_PER_MINUTE": "6",
    "EUNNEI_REQUESTS_PER_HOUR": "60"
  },
  "observability": { "enabled": false }
}
